{"stage": "sentence_segmentation", "order": 3, "summary": {"total_count": 397}, "result_snapshot": {"first_items": [{"sentence_id": "sent-058ca54b390f0cee", "text": "# ORION Test Text: Information Security\n\nInformation security is a discipline focused on protecting information assets against internal and external threats.", "index": 0, "start_offset": 0, "end_offset": 157, "source_text_id": "7dcd825d3f8f8d8eee7fbd9c1d16858f63333c4f174b4ab913fa3d64b104c9c9"}, {"sentence_id": "sent-d587e4643b4845fc", "text": "An information asset is any resource that has value for an organization and that stores, processes, transmits, or represents information.", "index": 1, "start_offset": 158, "end_offset": 295, "source_text_id": "7dcd825d3f8f8d8eee7fbd9c1d16858f63333c4f174b4ab913fa3d64b104c9c9"}, {"sentence_id": "sent-827cfb0ed55fd432", "text": "A confidential document is a type of information asset.", "index": 2, "start_offset": 296, "end_offset": 351, "source_text_id": "7dcd825d3f8f8d8eee7fbd9c1d16858f63333c4f174b4ab913fa3d64b104c9c9"}, {"sentence_id": "sent-b447ed0a73369de2", "text": "A corporate database is a type of information asset.", "index": 3, "start_offset": 352, "end_offset": 404, "source_text_id": "7dcd825d3f8f8d8eee7fbd9c1d16858f63333c4f174b4ab913fa3d64b104c9c9"}, {"sentence_id": "sent-00ab58639a11124f", "text": "A customer record is a type of information asset.", "index": 4, "start_offset": 405, "end_offset": 454, "source_text_id": "7dcd825d3f8f8d8eee7fbd9c1d16858f63333c4f174b4ab913fa3d64b104c9c9"}]}}
