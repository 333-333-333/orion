  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/decryption">
    <rdfs:label>Decryption</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/process"/>
    <rdfs:comment>Decryption is the process that converts encrypted data back into readable data.</rdfs:comment>
  </owl:Class>
