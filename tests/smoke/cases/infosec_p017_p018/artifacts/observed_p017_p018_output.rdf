    <rdfs:label>Container</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/cloudworkload"/>
    <rdfs:comment>A container is a type of cloud workload.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/cryptographickey">
    <rdfs:label>CryptographicKey</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/value"/>
    <rdfs:comment>A cryptographic key is a value used by a cryptographic algorithm.</rdfs:comment>
