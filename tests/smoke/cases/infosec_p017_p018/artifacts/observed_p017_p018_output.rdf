  <owl:Ontology rdf:about="https://orion.local/resource"/>
  <owl:Class rdf:about="https://orion.local/resource/administrativeboundaryforcloudresource">
    <rdfs:label>AdministrativeBoundaryForCloudResource</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/asymmetricencryption">
    <rdfs:label>AsymmetricEncryption</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/encryption"/>
    <rdfs:comment>Asymmetric encryption is a type of encryption that uses a public key and a private key.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/authenticity">
    <rdfs:label>Authenticity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/cloud">
    <rdfs:label>Cloud</rdfs:label>
    <rdfs:comment>A cloud access security broker monitors and controls cloud service usage.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/cloudaccount">
    <rdfs:label>CloudAccount</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/administrativeboundaryforcloudresource"/>
    <rdfs:comment>A cloud account is an administrative boundary for cloud resources.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/clouddata">
    <rdfs:label>CloudData</rdfs:label>
  </owl:Class>
