    <rdfs:label>CloudWorkload</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/computingresourcehostedinacloudenvironment"/>
    <rdfs:comment>A cloud workload is a type of computing resource hosted in a cloud environment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/computingresourcehostedinacloudenvironment">
    <rdfs:label>ComputingResourceHostedInACloudEnvironment</rdfs:label>
