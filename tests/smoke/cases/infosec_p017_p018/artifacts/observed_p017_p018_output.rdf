    <rdfs:label>CloudIdentity</rdfs:label>
    <rdfs:comment>A cloud identity is an identity used to access cloud services.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/cloudinfrastructure">
    <rdfs:label>CloudInfrastructure</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/cloudsecurity">
    <rdfs:label>CloudSecurity</rdfs:label>
    <rdfs:comment>Cloud security protects cloud services, cloud infrastructure, cloud workloads, and cloud data.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/cloudsecurityposturemanagementtool">
    <rdfs:label>CloudSecurityPostureManagementTool</rdfs:label>
