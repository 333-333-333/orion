  <owl:Class rdf:about="https://orion.local/resource/keymanagement">
    <rdfs:label>KeyManagement</rdfs:label>
    <rdfs:comment>Key management protects cryptographic keys across their lifecycle.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/keymanagementservice">
    <rdfs:label>KeyManagementService</rdfs:label>
    <rdfs:comment>A key management service stores and controls access to cryptographic keys.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/keyrevocation">
    <rdfs:label>KeyRevocation</rdfs:label>
    <rdfs:comment>Key revocation invalidates a compromised or obsolete key.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/keyrotation">
    <rdfs:label>KeyRotation</rdfs:label>
    <rdfs:comment>Key rotation replaces an existing key with a new key.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/keystorage">
    <rdfs:label>KeyStorage</rdfs:label>
    <rdfs:comment>Key storage protects a cryptographic key from unauthorized access.</rdfs:comment>
  </owl:Class>
