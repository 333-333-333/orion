    <rdfs:comment>Key rotation replaces an existing key with a new key.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/falsenegative">
    <rdfs:label>FalseNegative</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/misseddetectionofarealthreat"/>
    <rdfs:comment>A false negative is a missed detection of a real threat.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/falsepositive">
    <rdfs:label>FalsePositive</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/alert"/>
    <rdfs:comment>A false positive is an alert that does not represent a real threat.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/hardwaresecuritymodule">
    <rdfs:label>HardwareSecurityModule</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/device"/>
    <rdfs:comment>A hardware security module is a type of device designed to protect cryptographic keys.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/integrity">
    <rdfs:label>Integrity</rdfs:label>
