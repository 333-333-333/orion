@prefix orion: <https://orion.local/resource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

orion:multifactorauthentication orion:improves orion:authenticationstrength .
orion:multifactorauthentication orion:reduces orion:riskofunauthorizedaccesscausedbystolenpassword .
orion:multifactorauthentication orion:requirs orion:thanoneverificationfactor .
orion:AccessToken rdfs:subClassOf orion:TemporaryCredential .
orion:ApiKey rdfs:subClassOf orion:Credential .
orion:Certificate rdfs:subClassOf orion:CryptographicCredential .
orion:Credential rdfs:subClassOf orion:Evidence .
orion:Fingerprint rdfs:subClassOf orion:InherenceFactor .
orion:HardwareToken rdfs:subClassOf orion:PossessionFactor .
orion:InherenceFactor rdfs:subClassOf orion:AuthenticationFactorBasedOnSomethingTheUserIs .
orion:KnowledgeFactor rdfs:subClassOf orion:AuthenticationFactorBasedOnSomethingTheUserKnow .
orion:MobileAuthenticatorApplication rdfs:subClassOf orion:PossessionFactor .
orion:Password rdfs:subClassOf orion:Credential .
orion:Password rdfs:subClassOf orion:KnowledgeFactor .
orion:PossessionFactor rdfs:subClassOf orion:AuthenticationFactorBasedOnSomethingTheUserHas .
orion:PrivateKey rdfs:subClassOf orion:CryptographicSecret .
