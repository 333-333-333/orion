  <owl:ObjectProperty rdf:about="https://orion.local/resource/represents">
    <rdfs:label>Represents</rdfs:label>
    <rdfs:domain rdf:resource="https://orion.local/resource/useraccount"/>
    <rdfs:range rdf:resource="https://orion.local/resource/digitalidentity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://orion.local/resource/requires">
    <rdfs:label>Requires</rdfs:label>
    <rdfs:domain rdf:resource="https://orion.local/resource/restrictedinformation"/>
    <rdfs:range rdf:resource="https://orion.local/resource/storage"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://orion.local/resource/requires">
    <rdfs:label>Requires</rdfs:label>
    <rdfs:domain rdf:resource="https://orion.local/resource/restrictedinformation"/>
    <rdfs:range rdf:resource="https://orion.local/resource/strictaccess"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://orion.local/resource/requires">
