<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:meta="https://orion.local/meta/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="https://orion.local/resource"/>
  <owl:Class rdf:about="https://orion.local/resource/abilitytotraceactiontoaspecificidentity">
    <rdfs:label>AbilityToTraceActionToASpecificIdentity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/accesscontrol">
    <rdfs:label>AccessControl</rdfs:label>
    <rdfs:comment>Access control regulates who can access which resource and under which conditions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/accountability">
    <rdfs:label>Accountability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/abilitytotraceactiontoaspecificidentity"/>
    <rdfs:comment>Accountability is the ability to trace actions to a specific identity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/accountwithelevatedpermission">
    <rdfs:label>AccountWithElevatedPermission</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/authentication">
    <rdfs:label>Authentication</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/processofverifyinganidentity"/>
    <rdfs:comment>Authentication is the process of verifying an identity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/authenticationdata">
    <rdfs:label>AuthenticationData</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/restrictedinformationbecauseitcangrantaccesstosystem"/>
    <rdfs:comment>Authentication data is a type of restricted information because it can grant access to systems.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/authorization">
    <rdfs:label>Authorization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/processofdeterminingwhatactionanauthenticatedidentitymayperform"/>
    <rdfs:comment>Authorization is the process of determining what actions an authenticated identity may perform.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/bedisclosedwithoutcausingharm">
    <rdfs:label>BeDisclosedWithoutCausingHarm</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/canidentifyanaturalperson">
    <rdfs:label>CanIdentifyANaturalPerson</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/confidentialinformation">
    <rdfs:label>ConfidentialInformation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/informationwhoseunauthorizeddisclosuremayharmtheorganizationcustomeremployeeorpartner"/>
    <rdfs:comment>Confidential information is a type of information whose unauthorized disclosure may harm the organization, customers, employees, or partners.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/digitalidentity">
    <rdfs:label>DigitalIdentity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/financialdata">
    <rdfs:label>FinancialData</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/sensitiveinformationrelatedtopaymentaccountbudgetorfinancialtransaction"/>
    <rdfs:comment>Financial data is a type of sensitive information related to payments, accounts, budgets, or financial transactions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/highlysensitiveinformation">
    <rdfs:label>HighlySensitiveInformation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/identification">
    <rdfs:label>Identification</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/processofclaiminganidentity"/>
    <rdfs:comment>Identification is the process of claiming an identity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/informationclassification">
    <rdfs:label>InformationClassification</rdfs:label>
    <rdfs:comment>Information classification helps organizations apply appropriate protection levels to different kinds of information.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/informationwhoseunauthorizeddisclosuremayharmtheorganizationcustomeremployeeorpartner">
    <rdfs:label>InformationWhoseUnauthorizedDisclosureMayHarmTheOrganizationCustomerEmployeeOrPartner</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/internalinformation">
    <rdfs:label>InternalInformation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/publicinformation"/>
    <rdfs:comment>Internal information is a type of information intended for use inside the organization.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/nonhumanaccount">
    <rdfs:label>NonHumanAccount</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/organizationapplyappropriateprotectionleveltodifferentkindofinformation">
    <rdfs:label>OrganizationApplyAppropriateProtectionLevelToDifferentKindOfInformation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/personaldata">
    <rdfs:label>PersonalData</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/sensitiveinformation"/>
    <rdfs:comment>Personal data is a type of sensitive information that identifies or can identify a natural person.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/privilegedaccount">
    <rdfs:label>PrivilegedAccount</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/accountwithelevatedpermission"/>
    <rdfs:comment>A privileged account is a type of account with elevated permissions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/processofclaiminganidentity">
    <rdfs:label>ProcessOfClaimingAnIdentity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/processofdeterminingwhatactionanauthenticatedidentitymayperform">
    <rdfs:label>ProcessOfDeterminingWhatActionAnAuthenticatedIdentityMayPerform</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/processofverifyinganidentity">
    <rdfs:label>ProcessOfVerifyingAnIdentity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/publicinformation">
    <rdfs:label>PublicInformation</rdfs:label>
    <rdfs:comment>Public information is a type of information that can be disclosed without causing harm.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/restrictedinformation">
    <rdfs:label>RestrictedInformation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/highlysensitiveinformation"/>
    <rdfs:comment>Restricted information is a type of highly sensitive information that requires strict access, storage, and transmission controls.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/restrictedinformationbecauseitcangrantaccesstosystem">
    <rdfs:label>RestrictedInformationBecauseItCanGrantAccessToSystem</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/sensitiveinformation">
    <rdfs:label>SensitiveInformation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/sensitiveinformationrelatedtopaymentaccountbudgetorfinancialtransaction">
    <rdfs:label>SensitiveInformationRelatedToPaymentAccountBudgetOrFinancialTransaction</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/serviceaccount">
    <rdfs:label>ServiceAccount</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/nonhumanaccount"/>
    <rdfs:comment>A service account is a type of non-human account used by applications, scripts, integrations, or automated processes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/sharedaccount">
    <rdfs:label>SharedAccount</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/useraccount"/>
    <rdfs:comment>A shared account is a type of account used by multiple individuals and creates accountability risk.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/storage">
    <rdfs:label>Storage</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/strictaccess">
    <rdfs:label>StrictAccess</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/transmissioncontrol">
    <rdfs:label>TransmissionControl</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/under">
    <rdfs:label>Under</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/useraccount">
    <rdfs:label>UserAccount</rdfs:label>
    <rdfs:comment>A user account represents a digital identity.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://orion.local/resource/cans">
    <rdfs:label>Cans</rdfs:label>
    <rdfs:domain rdf:resource="https://orion.local/resource/publicinformation"/>
    <rdfs:range rdf:resource="https://orion.local/resource/bedisclosedwithoutcausingharm"/>
  </owl:ObjectProperty>
