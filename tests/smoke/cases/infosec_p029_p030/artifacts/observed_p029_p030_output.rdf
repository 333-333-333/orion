<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:meta="https://orion.local/meta/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="https://orion.local/resource"/>
  <owl:Class rdf:about="https://orion.local/resource/audit">
    <rdfs:label>Audit</rdfs:label>
    <rdfs:comment>An audit evaluates whether controls satisfy requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/besatisfied">
    <rdfs:label>BeSatisfied</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/compliance">
    <rdfs:label>Compliance</rdfs:label>
    <rdfs:comment>Compliance ensures that the organization meets legal, regulatory, contractual, and internal requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/compliancerequirement">
    <rdfs:label>ComplianceRequirement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/obligation"/>
    <rdfs:comment>A compliance requirement is an obligation that must be satisfied.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/compliancerequirementdefinedbytheorganization">
    <rdfs:label>ComplianceRequirementDefinedByTheOrganization</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/compliancerequirementdefinedinanagreement">
    <rdfs:label>ComplianceRequirementDefinedInAnAgreement</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/compliancerequirementderivedfromlaw">
    <rdfs:label>ComplianceRequirementDerivedFromLaw</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/compliancerequirementimposedbyaregulator">
    <rdfs:label>ComplianceRequirementImposedByARegulator</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/consent">
    <rdfs:label>Consent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/lawfulbasisforprocessinginsomecontext"/>
    <rdfs:comment>Consent is a lawful basis for processing in some contexts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/contractual">
    <rdfs:label>Contractual</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/contractualrequirement">
    <rdfs:label>ContractualRequirement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/compliancerequirementdefinedinanagreement"/>
    <rdfs:comment>A contractual requirement is a type of compliance requirement defined in an agreement.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/correctiveaction">
    <rdfs:label>CorrectiveAction</rdfs:label>
    <rdfs:comment>A corrective action addresses a nonconformity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datacontroller">
    <rdfs:label>DataController</rdfs:label>
    <rdfs:comment>A data controller determines the purposes and means of processing personal data.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datadeletionremovepersonaldatawhenit">
    <rdfs:label>DataDeletionRemovePersonalDataWhenIt</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/nolongerneeded"/>
    <rdfs:comment>Data deletion removes personal data when it is no longer needed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/dataminimizationlimitpersonaldatatowhat">
    <rdfs:label>DataMinimizationLimitPersonalDataToWhat</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/necessary"/>
    <rdfs:comment>Data minimization limits personal data to what is necessary.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/dataprocessor">
    <rdfs:label>DataProcessor</rdfs:label>
    <rdfs:comment>A data processor processes personal data on behalf of a controller.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datasubject">
    <rdfs:label>DataSubject</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/personwhosepersonaldataisprocessed"/>
    <rdfs:comment>A data subject is a person whose personal data is processed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datasubjectaboutprocessingactivity">
    <rdfs:label>DataSubjectAboutProcessingActivity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/demonstrationofcompliance">
    <rdfs:label>DemonstrationOfCompliance</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/evidence">
    <rdfs:label>Evidence</rdfs:label>
    <rdfs:comment>Evidence supports the demonstration of compliance.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/failuretomeetarequirement">
    <rdfs:label>FailureToMeetARequirement</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/internalrequirement">
    <rdfs:label>InternalRequirement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/compliancerequirementdefinedbytheorganization"/>
    <rdfs:comment>An internal requirement is a type of compliance requirement defined by the organization.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/lawfulbasisforprocessinginsomecontext">
    <rdfs:label>LawfulBasisForProcessingInSomeContext</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/legalrequirement">
    <rdfs:label>LegalRequirement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/compliancerequirementderivedfromlaw"/>
    <rdfs:comment>A legal requirement is a type of compliance requirement derived from law.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/necessary">
    <rdfs:label>Necessary</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/nolongerneeded">
    <rdfs:label>NoLongerNeeded</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/nonconformity">
    <rdfs:label>Nonconformity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/failuretomeetarequirement"/>
    <rdfs:comment>A nonconformity is a failure to meet a requirement.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/obligation">
    <rdfs:label>Obligation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/ofprocessingpersonaldata">
    <rdfs:label>OfProcessingPersonalData</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/personaldata">
    <rdfs:label>PersonalData</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/personaldataonbehalfofacontroller">
    <rdfs:label>PersonalDataOnBehalfOfAController</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/personwhosepersonaldataisprocessed">
    <rdfs:label>PersonWhosePersonalDataIsProcessed</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/privacy">
    <rdfs:label>Privacy</rdfs:label>
    <rdfs:comment>Privacy protects personal data and the rights of individuals.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/privacynotice">
    <rdfs:label>PrivacyNotice</rdfs:label>
    <rdfs:comment>A privacy notice informs data subjects about processing activities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/processingtodefinedpurpos">
    <rdfs:label>ProcessingToDefinedPurpos</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/purpos">
    <rdfs:label>Purpos</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/purposelimitation">
    <rdfs:label>PurposeLimitation</rdfs:label>
    <rdfs:comment>Purpose limitation restricts processing to defined purposes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/regulatory">
    <rdfs:label>Regulatory</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/regulatoryrequirement">
    <rdfs:label>RegulatoryRequirement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/compliancerequirementimposedbyaregulator"/>
    <rdfs:comment>A regulatory requirement is a type of compliance requirement imposed by a regulator.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/retentionlimitationrestricthowlongpersonaldata">
    <rdfs:label>RetentionLimitationRestrictHowLongPersonalData</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/stored"/>
    <rdfs:comment>Retention limitation restricts how long personal data is stored.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/rightofindividuals">
    <rdfs:label>RightOfIndividuals</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/stored">
    <rdfs:label>Stored</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/whethercontrolsatisfyrequirement">
    <rdfs:label>WhetherControlSatisfyRequirement</rdfs:label>
  </owl:Class>
