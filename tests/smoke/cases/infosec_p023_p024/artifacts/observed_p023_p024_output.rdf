  <owl:Class rdf:about="https://orion.local/resource/backup">
    <rdfs:label>Backup</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/copyofdata"/>
    <rdfs:comment>A backup is a copy of data used for recovery.</rdfs:comment>
  </owl:Class>
