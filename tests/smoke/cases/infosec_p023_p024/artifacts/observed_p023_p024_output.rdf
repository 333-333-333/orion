    <rdfs:label>DataBreach</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/securityincident"/>
    <rdfs:comment>A data breach is a type of security incident that involves unauthorized access to or disclosure of data.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/denialofserviceattack">
    <rdfs:label>DenialOfServiceAttack</rdfs:label>
