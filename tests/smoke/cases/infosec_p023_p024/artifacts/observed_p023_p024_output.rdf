    <rdfs:comment>A denial-of-service attack is a type of availability incident.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/disasterrecovery">
    <rdfs:label>DisasterRecovery</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/processofrestoringtechnologyserviceafteradisruptiveevent"/>
    <rdfs:comment>Disaster recovery is the process of restoring technology services after a disruptive event.</rdfs:comment>
  </owl:Class>
