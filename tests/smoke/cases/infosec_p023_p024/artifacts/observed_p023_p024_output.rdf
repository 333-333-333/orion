  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/backuppolicy">
    <rdfs:label>BackupPolicy</rdfs:label>
    <rdfs:comment>A backup policy defines backup frequency, retention, protection, and restoration requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/businesscontinuity">
    <rdfs:label>BusinessContinuity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/capability"/>
    <rdfs:comment>Business continuity is the capability to continue critical operations during disruption.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/capability">
    <rdfs:label>Capability</rdfs:label>
    <rdfs:comment>Business continuity is the capability to continue critical operations during disruption.</rdfs:comment>
