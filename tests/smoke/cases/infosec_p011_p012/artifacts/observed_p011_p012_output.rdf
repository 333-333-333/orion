    <rdfs:label>DormantAccountAccess</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/accessrisk"/>
    <rdfs:comment>Dormant account access is a type of access risk.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/excessivepermission">
    <rdfs:label>ExcessivePermission</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/accessrisk"/>
    <rdfs:comment>Excessive permission is a type of access risk.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/identityand">
    <rdfs:label>IdentityAnd</rdfs:label>
    <rdfs:comment>Identity and access management controls the lifecycle of identities, accounts, roles, permissions, and credentials.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/identitymanagementsystem">
    <rdfs:label>IdentityManagementSystem</rdfs:label>
    <rdfs:comment>The identity management system stores identity records.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/identityrecord">
    <rdfs:label>IdentityRecord</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/joiner">
    <rdfs:label>Joiner</rdfs:label>
    <rdfs:comment>A joiner process creates access for a new employee.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/leaver">
    <rdfs:label>Leaver</rdfs:label>
    <rdfs:comment>A leaver process removes access when a person leaves the organization.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/managementcontrolthelifecycleofidentities">
    <rdfs:label>ManagementControlTheLifecycleOfIdentities</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/mover">
    <rdfs:label>Mover</rdfs:label>
    <rdfs:comment>A mover process changes access when a person changes role.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/newuseraccount">
    <rdfs:label>NewUserAccount</rdfs:label>
  </owl:Class>
