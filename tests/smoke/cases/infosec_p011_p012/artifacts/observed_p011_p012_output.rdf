    <rdfs:comment>Orphaned account access is a type of access risk.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/permission">
    <rdfs:label>Permission</rdfs:label>
    <rdfs:label>Permission roles subject object</rdfs:label>
    <rdfs:comment>A permission grants an action over a resource.</rdfs:comment>
