  <owl:Class rdf:about="https://orion.local/resource/roletoanidentity">
    <rdfs:label>RoleToAnIdentity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/segregationof">
    <rdfs:label>SegregationOf</rdfs:label>
    <rdfs:comment>Segregation of duties prevents one person from controlling incompatible activities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/userdeprovisioning">
    <rdfs:label>UserDeprovisioning</rdfs:label>
    <rdfs:comment>User deprovisioning disables or removes access for a user who no longer requires it.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/usergroup">
    <rdfs:label>UserGroup</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/collectionofidentities"/>
