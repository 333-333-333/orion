  <owl:Class rdf:about="https://orion.local/resource/authorizedentity">
    <rdfs:label>AuthorizedEntity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/availability">
    <rdfs:label>Availability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/securityproperty"/>
    <rdfs:comment>Availability is a security property that ensures information and systems are accessible when needed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/backuparchive">
    <rdfs:label>BackupArchive</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/informationasset"/>
    <rdfs:comment>A backup archive is a type of information asset.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/businessreport">
    <rdfs:label>BusinessReport</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/informationasset"/>
    <rdfs:comment>A business report is a type of information asset.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/ciatriad">
    <rdfs:label>CiaTriad</rdfs:label>
    <rdfs:label>CiaTriad roles subject object</rdfs:label>
    <rdfs:comment>Confidentiality, integrity, and availability form the CIA triad.</rdfs:comment>
    <rdfs:comment>The CIA triad is a foundational model for information security.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/confidentialdocument">
    <rdfs:label>ConfidentialDocument</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/informationasset"/>
    <rdfs:comment>A confidential document is a type of information asset.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/confidentiality">
    <rdfs:label>Confidentiality</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/securityproperty"/>
    <rdfs:comment>Confidentiality is a security property that ensures information is accessible only to authorized entities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/corporatedatabase">
    <rdfs:label>CorporateDatabase</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/informationasset"/>
    <rdfs:comment>A corporate database is a type of information asset.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/customerrecord">
    <rdfs:label>CustomerRecord</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/informationasset"/>
    <rdfs:comment>A customer record is a type of information asset.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/discipline">
    <rdfs:label>Discipline</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/externalthreat">
    <rdfs:label>ExternalThreat</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/threat"/>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/information">
    <rdfs:label>Information</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/informationasset">
    <rdfs:label>InformationAsset</rdfs:label>
    <rdfs:label>InformationAsset roles subject object</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/resource"/>
    <rdfs:comment>An information asset is any resource that has value for an organization and that stores, processes, transmits, or represents information.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/informationsecurity">
    <rdfs:label>InformationSecurity</rdfs:label>
    <rdfs:label>InformationSecurity roles subject object</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/discipline"/>
    <rdfs:comment>Information security is a discipline focused on protecting information assets against internal and external threats.</rdfs:comment>
    <rdfs:comment>The purpose of information security is to preserve confidentiality, integrity, and availability.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/integrity">
    <rdfs:label>Integrity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/securityproperty"/>
    <rdfs:comment>Integrity is a security property that ensures information is accurate, complete, and protected against unauthorized modification.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/internalthreat">
    <rdfs:label>InternalThreat</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://orion.local/resource/threat"/>
  </owl:Class>
