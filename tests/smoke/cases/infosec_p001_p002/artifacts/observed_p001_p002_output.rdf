    <orion:protects rdf:resource="https://orion.local/resource/informationasset"/>
    <orion:protectsagainst rdf:resource="https://orion.local/resource/threat"/>
    <orion:preserves rdf:resource="https://orion.local/resource/securityproperty"/>
