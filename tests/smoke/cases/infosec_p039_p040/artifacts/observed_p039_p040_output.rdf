    <rdfs:label>Corrective</rdfs:label>
    <rdfs:comment>Corrective actions may include patch deployment, privilege reduction, and improved detection rules.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/employee">
    <rdfs:label>Employee</rdfs:label>
    <rdfs:comment>The employee clicks the malicious link and submits a password.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/event">
    <rdfs:label>Event</rdfs:label>
    <rdfs:comment>The event affects availability and may affect integrity.</rdfs:comment>
  </owl:Class>
