  <owl:Class rdf:about="https://orion.local/resource/maliciouslink">
    <rdfs:label>MaliciousLink</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/malware">
    <rdfs:label>Malware</rdfs:label>
    <rdfs:comment>Malware encrypts files on a file server.</rdfs:comment>
