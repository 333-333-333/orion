  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://orion.local/resource/reduces">
    <rdfs:label>Reduces</rdfs:label>
    <rdfs:domain rdf:resource="https://orion.local/resource/control"/>
    <rdfs:range rdf:resource="https://orion.local/resource/riskbypreventing"/>
