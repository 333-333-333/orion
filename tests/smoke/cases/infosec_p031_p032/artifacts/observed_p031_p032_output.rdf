  <owl:Class rdf:about="https://orion.local/resource/dataarchival">
    <rdfs:label>DataArchival</rdfs:label>
    <rdfs:comment>Data archival stores information for long-term retention.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/dataclassification">
    <rdfs:label>DataClassification</rdfs:label>
    <rdfs:comment>Data classification applies labels to information.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datacreation">
    <rdfs:label>DataCreation</rdfs:label>
    <rdfs:comment>Data creation produces new information.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datadisposal">
    <rdfs:label>DataDisposal</rdfs:label>
    <rdfs:comment>Data disposal removes information when retention expires.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datahandling">
    <rdfs:label>DataHandling</rdfs:label>
    <rdfs:comment>Data handling rules define how each classification level must be protected.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datalifecyclemanagement">
    <rdfs:label>DataLifecycleManagement</rdfs:label>
    <rdfs:comment>Data lifecycle management protects information from creation to disposal.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/dataprocessing">
    <rdfs:label>DataProcessing</rdfs:label>
    <rdfs:comment>Data processing transforms or uses information.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datasharing">
    <rdfs:label>DataSharing</rdfs:label>
    <rdfs:comment>Data sharing provides information to another party.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datastorage">
    <rdfs:label>DataStorage</rdfs:label>
    <rdfs:comment>Data storage keeps information in a repository.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/datatransmission">
    <rdfs:label>DataTransmission</rdfs:label>
    <rdfs:comment>Data transmission moves information between systems or people.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/definehoweachclassificationlevelmustbeprotected">
    <rdfs:label>DefineHowEachClassificationLevelMustBeProtected</rdfs:label>
