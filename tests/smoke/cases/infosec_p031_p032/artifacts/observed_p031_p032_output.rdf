  <owl:Class rdf:about="https://orion.local/resource/changemanagement">
    <rdfs:label>ChangeManagement</rdfs:label>
    <rdfs:comment>Change management controls modifications to systems, applications, infrastructure, and configurations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/changerequest">
    <rdfs:label>ChangeRequest</rdfs:label>
    <rdfs:comment>A change request proposes a modification.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/changerollback">
    <rdfs:label>ChangeRollback</rdfs:label>
    <rdfs:comment>Change rollback restores a previous state if a change fails.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://orion.local/resource/configuration">
    <rdfs:label>Configuration</rdfs:label>
